generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MENTOR
  /// Head of another club: sees sign-up stats, the users table, and can post
  /// announcements, but has no access to Projects/Mentors/Mail senders.
  COORDINATOR
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  iitId         String?
  role          Role           @default(STUDENT)
  mentorId      String?
  /// Set the first time a user completes OTP verification (registration or
  /// password reset). Null means they've never finished that step yet.
  passwordHash  String?
  createdAt     DateTime       @default(now())
  otpCodes      OtpCode[]
  sessions      Session[]
  registrations Registration[]
  conversations Conversation[]
  sentMessages  Message[]
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A Google Apps Script mailer (scripts/gas-mailer.gs) deployed under one
/// Google account. OTP emails go through enabled senders in `priority`
/// order, falling through to the next when one fails (e.g. daily quota hit).
model MailSender {
  id          String    @id @default(cuid())
  label       String
  webhookUrl  String
  secret      String
  enabled     Boolean   @default(true)
  priority    Int       @default(0)
  lastUsedAt  DateTime?
  lastError   String?
  lastErrorAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// The head of another club, invited by email from /admin. Registering with
/// this email grants the COORDINATOR role (restricted admin access: stats,
/// users, announcements — no Projects/Mentors/Mail senders).
model Coordinator {
  id        String   @id @default(cuid())
  /// Lowercased. Registering with this email grants the COORDINATOR role.
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

/// A project mentor, managed from /admin. Projects list their mentors in
/// `Project.mentorIds`.
model Mentor {
  id        String   @id @default(cuid())
  name      String
  iitId     String
  bio       String
  expertise String[]
  /// GitHub username (not a URL).
  github    String?
  /// Lowercased. Registering with this email grants the MENTOR role.
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
}

/// A participating repository, managed from /admin. Registrations refer to
/// it by `slug` (not a foreign key), so renaming a slug must update them too.
model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String
  longDescription  String?
  iitId            String
  track            String   @default("Beginner")
  technologies     String[]
  /// Ids from data/mentors.ts.
  mentorIds        String[]
  repositoryUrl    String?
  documentationUrl String?
  issuesUrl        String?
  featured         Boolean  @default(false)
  /// Unpublished projects are hidden from the site but kept for editing.
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Registration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectSlug String
  createdAt   DateTime @default(now())

  @@unique([userId, projectSlug])
  @@index([projectSlug])
}

/// A DM thread between a user (usually a student) and a mentor. One thread
/// per pair; `projectSlug` just records which project it was started from.
model Conversation {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorId      String
  mentor        Mentor    @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  projectSlug   String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([userId, mentorId])
  @@index([mentorId])
}

/// A "what's new" post about the Hello FOSS site itself, managed from
/// /admin and shown on /updates. Not related to a project's own repo.
model Announcement {
  id           String   @id @default(cuid())
  title        String
  body         String
  published    Boolean  @default(true)
  /// Shown in the scrolling banner at the top of every page.
  showAsBanner Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// The User who sent it — either the conversation's student or the user
  /// account linked to its mentor. Compare against `conversation.userId` to
  /// tell which side sent a given message.
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}
