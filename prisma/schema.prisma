generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  iitId         String?
  role          Role           @default(STUDENT)
  mentorId      String?
  /// Set the first time a user completes OTP verification (registration or
  /// password reset). Null means they've never finished that step yet.
  passwordHash  String?
  createdAt     DateTime       @default(now())
  otpCodes      OtpCode[]
  sessions      Session[]
  registrations Registration[]
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Registration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectSlug String
  createdAt   DateTime @default(now())

  @@unique([userId, projectSlug])
  @@index([projectSlug])
}
