generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  iitId         String?
  role          Role           @default(STUDENT)
  mentorId      String?
  /// Set the first time a user completes OTP verification (registration or
  /// password reset). Null means they've never finished that step yet.
  passwordHash  String?
  createdAt     DateTime       @default(now())
  otpCodes      OtpCode[]
  sessions      Session[]
  registrations Registration[]
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A Google Apps Script mailer (scripts/gas-mailer.gs) deployed under one
/// Google account. OTP emails go through enabled senders in `priority`
/// order, falling through to the next when one fails (e.g. daily quota hit).
model MailSender {
  id          String    @id @default(cuid())
  label       String
  webhookUrl  String
  secret      String
  enabled     Boolean   @default(true)
  priority    Int       @default(0)
  lastUsedAt  DateTime?
  lastError   String?
  lastErrorAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// A project mentor, managed from /admin. Projects list their mentors in
/// `Project.mentorIds`.
model Mentor {
  id        String   @id @default(cuid())
  name      String
  iitId     String
  bio       String
  expertise String[]
  /// GitHub username (not a URL).
  github    String?
  /// Lowercased. Registering with this email grants the MENTOR role.
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A participating repository, managed from /admin. Registrations refer to
/// it by `slug` (not a foreign key), so renaming a slug must update them too.
model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String
  longDescription  String?
  iitId            String
  track            String   @default("Beginner")
  technologies     String[]
  /// Ids from data/mentors.ts.
  mentorIds        String[]
  repositoryUrl    String?
  documentationUrl String?
  issuesUrl        String?
  featured         Boolean  @default(false)
  /// Unpublished projects are hidden from the site but kept for editing.
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Registration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectSlug String
  createdAt   DateTime @default(now())

  @@unique([userId, projectSlug])
  @@index([projectSlug])
}
