# Postgres connection string. Locally: `docker compose -f docker-compose.dev.yml up -d`
# then use the value below. In Coolify, paste the internal connection string from
# your provisioned Postgres resource.
DATABASE_URL="postgresql://hellofoss:hellofoss@localhost:5432/hellofoss?schema=public"

# Random secret used to hash OTP codes and session tokens (HMAC pepper).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Comma-separated list of emails that get ADMIN access regardless of institute.
ADMIN_EMAILS=""

# Google Apps Script web app used to send OTP emails via MailApp (free;
# see scripts/gas-mailer.gs for the script + deployment steps). Leave both
# unset in dev, OTPs are printed to the server console and returned in the
# API response instead.
GAS_MAIL_WEBHOOK_URL=""
GAS_MAIL_SECRET=""

